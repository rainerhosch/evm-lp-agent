# ── Wallet ──────────────────────────────────────────
# Hex private key (with or without 0x). NEVER commit real keys.
EVM_PRIVATE_KEY=

# ── RPCs (public defaults work for read; use paid RPC for production) ──
ETH_RPC_URL=https://ethereum.publicnode.com
BSC_RPC_URL=https://bsc-dataseed.binance.org
BASE_RPC_URL=https://mainnet.base.org
ARB_RPC_URL=https://arb1.arbitrum.io/rpc
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Active chain: ethereum | bsc | base | arbitrum | robinhood
# Robinhood Chain = chainId 4663, Uniswap V3 (not Ethereum mainnet pools)
EVM_CHAIN=ethereum

# ── LLM — OpenRouter Free Models Router ─────────────
# Docs: https://openrouter.ai/openrouter/free
# Reasoning: https://openrouter.ai/docs/guides/best-practices/reasoning-tokens
OPENROUTER_API_KEY=
# LLM_API_KEY=                    # alias for OPENROUTER_API_KEY
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openrouter/free       # free router (tools-aware model selection)
# OPENROUTER_REASONING_EFFORT=medium   # max|high|medium|low|minimal|none
# OPENROUTER_HTTP_REFERER=https://github.com/evm-lp-agent
# OPENROUTER_APP_TITLE=evm-lp-agent

# ── Optional The Graph (better pool history when set) ─
# GRAPH_API_KEY=

# ── CoinGecko (native ETH/BNB → USD) ────────────────
# Docs: https://docs.coingecko.com/reference/simple-price
# Free public API works without a key (rate-limited). Demo/Pro key optional.
# COINGECKO_API_KEY=
# COINGECKO_PRO=true          # use pro-api.coingecko.com + x-cg-pro-api-key
# COINGECKO_CACHE_TTL_MS=60000

# Telegram (deploy/close/screen notifications — Meridian-style)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# optional: also user-config.json → "telegramChatId"

# ── Safety ──────────────────────────────────────────
DRY_RUN=true
LOG_LEVEL=info
